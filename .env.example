# Configuração do Banco de Dados
# Para desenvolvimento local com SQLite (padrão se não configurado):
# DATABASE_URL=sqlite:///gdev.db
# Para PostgreSQL:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/gdev_tutorial

# Chave secreta (gere uma chave forte para produção)
SECRET_KEY=dev-secret-key-change-in-production

# Ambiente
FLASK_ENV=development
FLASK_DEBUG=1

# Credenciais do Admin (opcional - usa padrões se não configurado)
ADMIN_EMAIL=admin@gdevtutorial.com
ADMIN_PASSWORD=admin123
ADMIN_USERNAME=admin

# Integração com o Cloudinary (para upload de imagens/thumbnails)
# Você pode usar a URL única de conexão (recomendado para Railway):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Ou as credenciais individuais:
# CLOUDINARY_CLOUD_NAME=seu_cloud_name
# CLOUDINARY_API_KEY=sua_api_key
# CLOUDINARY_API_SECRET=sua_api_secret
